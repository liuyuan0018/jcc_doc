  "cues": [
    {
      "id": "V01",
      "text": "蔚的八套出装，你平时用哪套？",
      "spoken": "魏的八套出装，你平时用哪套？"
    },
    {
      "id": "V02",
      "text": "这次做固定条件模拟。每档满血，撑满三十秒，再加五十来伤。",
      "spoken": "这次做固定条件模拟。每档满血，撑满三十秒，再加五十来伤。",
      "displayLines": [
        "这次做固定条件模拟。",
        "每档满血，撑满三十秒，再加五十来伤。"
      ]
    },
    {
      "id": "V03",
      "text": "这档八套全过，继续加。",
      "spoken": "这档八套全过，继续加。"
    },
    {
      "id": "V04",
      "text": "一千九，羊刀泰坦和泰坦狂徒都没过，并列第七。",
      "spoken": "一千九，羊刀泰坦和泰坦狂徒都没过，并列第七。",
      "displayLines": [
        "一千九，羊刀泰坦和泰坦狂徒都没过，",
        "并列第七。"
      ]
    },
    {
      "id": "V05",
      "text": "羊刀狂徒在两千这档停下，比羊刀泰坦多通过两档。",
      "spoken": "羊刀狂徒在两千这档停下，比羊刀泰坦多通过两档。",
      "displayLines": [
        "羊刀狂徒在两千这档停下，",
        "比羊刀泰坦多通过两档。"
      ]
    },
    {
      "id": "V06",
      "text": "羊刀饮血也倒了，还剩四套。",
      "spoken": "羊刀饮血也倒了，还剩四套。"
    },
    {
      "id": "V07",
      "text": "饮血狂徒和饮血振奋都没过，最高通过两千零五十，并列第三。",
      "spoken": "饮血狂徒和饮血振奋都没过，最高通过两千零五十，并列第三。",
      "displayLines": [
        "饮血狂徒和饮血振奋都没过，",
        "最高通过两千零五十，并列第三。"
      ]
    },
    {
      "id": "V08",
      "text": "大天使双板也到头了，只剩饮血双板。",
      "spoken": "大天使双板也到头了，只剩饮血双板。"
    },
    {
      "id": "V09",
      "text": "两千一百五通过，继续测上限。",
      "spoken": "两千一百五通过，继续测上限。"
    },
    {
      "id": "V10",
      "text": "再加到两千二。",
      "spoken": "再加到两千二。"
    },
    {
      "id": "V11",
      "text": "三十秒，这一档还是站住了。",
      "spoken": "三十秒，这一档还是站住了。"
    },
    {
      "id": "V12",
      "text": "再加五十。",
      "spoken": "再加五十。"
    },
    {
      "id": "V13",
      "text": "两千二百五，二十九秒倒下。最高通过两千二。",
      "spoken": "两千二百五，二十九秒倒下。最高通过两千二。",
      "displayLines": [
        "两千二百五，二十九秒倒下。",
        "最高通过两千二。"
      ]
    },
    {
      "id": "V14",
      "text": "这组条件下，饮血双板比羊刀泰坦高三百五十。",
      "spoken": "这组条件下，饮血双板比羊刀泰坦高三百五十。",
      "displayLines": [
        "这组条件下，",
        "饮血双板比羊刀泰坦高三百五十。"
      ]
