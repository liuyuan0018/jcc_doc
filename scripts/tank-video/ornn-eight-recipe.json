  "cues": [
    {
      "id": "O01",
      "text": "这次沿用上期条件，模拟对比奥恩的八套装备，其中四套是纯肉搭配。",
      "spoken": "这次沿用上期条件，模拟对比奥恩的八套装备，其中四套是纯肉搭配。",
      "displayLines": [
        "这次沿用上期条件，模拟对比奥恩的八套装备，",
        "其中四套是纯肉搭配。"
      ]
    },
    {
      "id": "O02",
      "text": "统一三星、六护卫、六人口，不带指定装备海克斯。",
      "spoken": "统一三星、六护卫、六人口，不带指定装备海克斯。"
    },
    {
      "id": "O03",
      "text": "每档满血重开，三十秒结算时还站着，来伤就加五十。",
      "spoken": "每档满血重开，三十秒结算时还站着，来伤就加五十。",
      "displayLines": [
        "每档满血重开，",
        "三十秒结算时还站着，来伤就加五十。"
      ]
    },
    {
      "id": "O04",
      "text": "上期那套在左上，下两行是四套纯肉。这里统一按技能命中三个目标来算。",
      "spoken": "上期那套在左上，下两行是四套纯肉。这里统一按技能命中三个目标来算。",
      "displayLines": [
        "上期那套在左上，下两行是四套纯肉。",
        "这里统一按技能命中三个目标来算。"
      ]
    },
    {
      "id": "O05",
      "text": "五百五十，双石像鬼加狂徒，到结算时倒下了。",
      "spoken": "五百五十，双石像鬼加狂徒，到结算时倒下了。"
    },
    {
      "id": "O06",
      "text": "六百，反甲、龙牙加狂徒也没过。",
      "spoken": "六百，反甲、龙牙加狂徒也没过。"
    },
    {
      "id": "O07",
      "text": "六百五十，B组和H组都没过，最高通过六百。",
      "spoken": "六百五十，B组和H组都没过，最高通过六百。"
    },
    {
      "id": "O08",
      "text": "七百，饮血和振奋这组对照也都没过。两套同档并列。",
      "spoken": "七百，饮血和振奋这组对照也都没过。两套同档并列。",
      "displayLines": [
        "七百，饮血和振奋这组对照也都没过。",
        "两套同档并列。"
      ]
    },
    {
      "id": "O09",
      "text": "八百五十，去饮血的C组没过。A组通过。",
      "spoken": "八百五十，去饮血的C组没过。A组通过。"
    },
    {
      "id": "O10",
      "text": "只剩饮血、正义、大天使这套，继续加压。",
      "spoken": "只剩饮血、正义、大天使这套，继续加压。"
    },
    {
      "id": "O11",
      "text": "九百五十，通过。",
      "spoken": "九百五十，通过。"
    },
    {
      "id": "O12",
      "text": "一千一百，通过。",
      "spoken": "一千一百，通过。"
    },
    {
      "id": "O13",
      "text": "一千二，三十秒通过。再加五十。",
      "spoken": "一千二，三十秒通过。再加五十。"
    },
    {
      "id": "O14",
      "text": "一千二百五十，这次没撑住。",
      "spoken": "一千二百五十，这次没撑住。"
    },
    {
      "id": "O15",
      "text": "本轮八套里，饮血、正义、大天使最高，通过每秒一千二。再加五十就没过。",
      "spoken": "本轮八套里，饮血、正义、大天使最高，通过每秒一千二。再加五十就没过。",
      "displayLines": [
        "本轮八套里，饮血、正义、大天使最高，",
        "通过每秒一千二。再加五十就没过。"
      ]
    },
    {
      "id": "O16",
      "text": "四套纯肉里，振奋、石像鬼、狂徒最高，通过六百五十。",
      "spoken": "四套纯肉里，振奋、石像鬼、狂徒最高，通过六百五十。",
      "displayLines": [
        "四套纯肉里，振奋、石像鬼、狂徒最高，",
        "通过六百五十。"
      ]
    },
    {
      "id": "O17",
      "text": "同样的石像鬼和狂徒，搭饮血与搭振奋的成绩相同，不能只看有没有饮血就下结论。",
      "spoken": "同样的石像鬼和狂徒，搭饮血与搭振奋的成绩相同，不能只看有没有饮血就下结论。"
