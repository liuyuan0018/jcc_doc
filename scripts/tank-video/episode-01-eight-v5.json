  "cues": [
    {
      "id": "c01",
      "text": "三件普通装，八个前排，谁能扛到最后？",
      "spoken": "三件普通装，八个前排，谁能扛到最后？"
    },
    {
      "id": "c02",
      "text": "每轮满血重开，撑满三十秒，就加五十。",
      "spoken": "每轮满血重开，撑满三十秒，就加五十。"
    },
    {
      "id": "c03",
      "text": "先从每秒一千一百五开始。",
      "spoken": "先从每秒一千一百五开始。"
    },
    {
      "id": "c04",
      "text": "加到每秒一千二。",
      "spoken": "加到每秒一千二。"
    },
    {
      "id": "c05",
      "text": "蜘蛛没撑到三十秒。",
      "spoken": "蜘蛛没撑到三十秒。"
    },
    {
      "id": "c06",
      "text": "加到每秒一千二百五。",
      "spoken": "加到每秒一千二百五。"
    },
    {
      "id": "c07",
      "text": "奥恩、河蟹和洛都没过，这三位并列第五。",
      "spoken": "奥恩、河蟹和洛都没过，这三位并列第五。"
    },
    {
      "id": "c08",
      "text": "再加到每秒一千三。",
      "spoken": "再加到每秒一千三。"
    },
    {
      "id": "c09",
      "text": "慎也没撑到三十秒。",
      "spoken": "慎也没撑到三十秒。"
    },
    {
      "id": "c10",
      "text": "继续加压，看看剩下这三位。",
      "spoken": "继续加压，看看剩下这三位。"
    },
    {
      "id": "c11",
      "text": "一千四百五，三个都过了。",
      "spoken": "一千四百五，三个都过了。"
    },
    {
      "id": "c12",
      "text": "加到每秒一千五。",
      "spoken": "加到每秒一千五。"
    },
    {
      "id": "c13",
      "text": "猪妹也没撑住，还剩两个。",
      "spoken": "猪妹也没撑住，还剩两个。"
    },
    {
      "id": "c14",
      "text": "龙龟和蔚继续往上加。",
      "spoken": "龙龟和魏继续往上加。"
    },
    {
      "id": "c15",
      "text": "一千九，两个都过了。",
      "spoken": "一千九，两个都过了。"
    },
    {
      "id": "c16",
      "text": "再加到每秒一千九百五。",
      "spoken": "再加到每秒一千九百五。"
    },
    {
      "id": "c17",
      "text": "龙龟倒了。",
      "spoken": "龙龟倒了。"
    },
    {
      "id": "c18",
      "text": "只剩蔚了，继续测她的上限。",
      "spoken": "只剩魏了，继续测她的上限。"
    },
    {
      "id": "c19",
      "text": "两千一百五，也过了。",
      "spoken": "两千一百五，也过了。"
    },
    {
      "id": "c20",
      "text": "再加到两千二。",
      "spoken": "再加到两千二。"
    },
    {
      "id": "c21",
      "text": "三十秒，还是站住了。",
      "spoken": "三十秒，还是站住了。"
    },
    {
      "id": "c22",
      "text": "再加五十。",
      "spoken": "再加五十。"
    },
    {
      "id": "c23",
      "text": "两千二百五，没撑住。",
      "spoken": "两千二百五，没撑住。"
    },
    {
      "id": "c24",
      "text": "这组测试，蔚最高扛住每秒两千二。",
      "spoken": "这组测试，魏最高扛住每秒两千二。"
    }
  ],
