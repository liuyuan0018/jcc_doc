#!/bin/sh
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
task_python=${DUAL_RANK_PYTHON:-/Users/lyu/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python}
